# Copier en .env et completer. Ne jamais committer le .env reel.

# --- Application (secrets applicatifs existants) -----------------------------
SECRET_KEY=change-me-en-dev
JWT_SECRET_KEY=change-me-en-dev

# --- Base de donnees -----------------------------------------------------------
# Ce fichier est lu par l'application elle-meme (voir `db_uri.py`), donc c'est
# lui qui decide sur quelle base tourne le dispositif. Sans lui, tout retombe
# sur SQLite — utilisable, mais sans le privilege refuse qui fait tenir le
# journal d'audit.
#
# L'utilisateur applicatif : cree par `python provision_postgres.py`, avec un
# GRANT complet sur les tables metier mais SELECT+INSERT seul sur audit_log
# (REVOKE UPDATE, DELETE explicite). C'est la connexion normale de l'app, et
# elle ne peut ni creer ni supprimer une table.
CARTEPRO_APP_DB_PASSWORD=change-me
TICKET_TOUT_DATABASE_URI=postgresql+psycopg2://cartepro_app:change-me@localhost:5432/cartepro

# L'utilisateur privilegie (le superutilisateur POSTGRES_USER du
# docker-compose). Sert UNIQUEMENT a `provision_postgres.py`,
# `migrate_sqlite_to_postgres.py` et `demo_audit_tamper.sh` — jamais a
# l'application elle-meme, ni a une route. C'est ce compte que la demonstration
# de jeudi utilise pour alterer une ligne : l'utilisateur applicatif n'en a plus
# le droit. `seed.py` et `migrer.py` s'en servent aussi, parce qu'ils font du
# DDL — un `drop_all()` demande d'etre proprietaire des tables.
# Le mot de passe ci-dessous est celui du docker-compose.yml, un defaut de
# developpement — a remplacer partout ailleurs que sur un poste local. Pour le
# changer, poser POSTGRES_PASSWORD dans un `.env` **a la racine du depot**
# (c'est de la que Docker Compose interpole, pas depuis ce fichier-ci) et
# reporter la meme valeur dans l'URI ci-dessous.
POSTGRES_PASSWORD=postgres-superuser-dev-only
AUDIT_DB_SUPERUSER_URI=postgresql+psycopg2://postgres:postgres-superuser-dev-only@localhost:5432/cartepro

# --- Journal d'audit -------------------------------------------------------
# Cle HMAC-SHA256 de signature de l'export. Generer avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_EXPORT_HMAC_KEY=change-me
